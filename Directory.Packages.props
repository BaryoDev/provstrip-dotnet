<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- The Umbraco version the test site runs. CI overrides it (-p:UmbracoVersion=17.8.1). Set here because this
         file is imported before a project's own PropertyGroup runs. -->
    <UmbracoVersion Condition="'$(UmbracoVersion)' == ''">18.3.1</UmbracoVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Build.Utilities.Core" Version="17.7.2" />
    <!-- The package's own references are ranges, set per framework with VersionOverride in its csproj. -->
    <PackageVersion Include="Umbraco.Cms.Api.Management" Version="17.0.0" />
    <PackageVersion Include="Umbraco.Cms" Version="$(UmbracoVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
  </ItemGroup>
</Project>
