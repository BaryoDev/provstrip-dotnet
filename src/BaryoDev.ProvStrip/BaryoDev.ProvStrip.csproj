<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>BaryoDev.ProvStrip</PackageId>
    <Title>ProvStrip</Title>
    <Description>Remove AI attribution (C2PA, XMP, Software tags) and camera data (EXIF, GPS, IPTC) from PNG, JPEG, WebP and SVG by cutting bytes, never re-encoding. Unknown data stops the operation instead of slipping through.</Description>
    <PackageTags>c2pa provenance exif metadata strip png jpeg webp svg</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Rules/rules.json" LogicalName="BaryoDev.ProvStrip.rules.json" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="BaryoDev.ProvStrip.Tests" />
    <InternalsVisibleTo Include="BaryoDev.ProvStrip.Tool.Tests" />
    <InternalsVisibleTo Include="BaryoDev.ProvStrip.Build.Tests" />
  </ItemGroup>
</Project>
